# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/veloura
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/veloura
MONGO_URI=mongodb://127.0.0.1:27017/veloura

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000

# Optional: used only by the admin seed script
SEED_ADMIN_NAME=Veloura Admin
SEED_ADMIN_EMAIL=admin@veloura.com
SEED_ADMIN_PASSWORD=Admin123!

# --- Order notifications (all optional) ---
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFICATION_EMAIL=eltonyahmed232@gmail.com

# WhatsApp: use EITHER CallMeBot (simplest) OR Twilio - see README section 10
CALLMEBOT_PHONE=+201554372442
CALLMEBOT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_WHATSAPP_NUMBER=+201554372442
