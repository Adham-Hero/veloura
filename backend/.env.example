# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/veloura
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/veloura
MONGO_URI=mongodb://127.0.0.1:27017/veloura

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000

# Optional: used only by the admin seed script
SEED_ADMIN_NAME=Veloura Admin
SEED_ADMIN_EMAIL=admin@veloura.com
SEED_ADMIN_PASSWORD=Admin123!

# --- Order notifications (all optional - if left blank, that channel is skipped) ---

# Gmail address used to SEND notification/invoice emails, and its App Password
# (NOT your normal Gmail password - see README for how to generate one)
EMAIL_USER=
EMAIL_PASS=

# Where the "new order" admin alert email is sent
ADMIN_NOTIFICATION_EMAIL=eltonyahmed232@gmail.com

# WhatsApp via Meta's official Cloud API (see README section 10.2)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Admin's phone in international format, digits only - no "+", no leading 0
WHATSAPP_ADMIN_PHONE=201554372442
# Must match the approved template's name/language exactly
WHATSAPP_TEMPLATE_NAME=order_notification
WHATSAPP_TEMPLATE_LANG=en_US
