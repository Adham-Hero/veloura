# MongoDB connection string

# Local example:

# mongodb://127.0.0.1:27017/veloura

# MongoDB Atlas

MONGODB_USERNAME="eltonyahmed232_db_user"
MONGODB_PASSWORD="NEW_PASSWORD"
MONGODB_URI="mongodb+srv://eltonyahmed232_db_user:NEW_PASSWORD@cluster0.msnzrxb.mongodb.net/veloura?appName=Cluster0"

# Secret used to sign JWT tokens

JWT_SECRET=YOUR_GENERATED_JWT_SECRET

# Port the backend server will run on

PORT=5000

# Admin seed information

SEED_ADMIN_NAME="Veloura Admin"
SEED_ADMIN_EMAIL="[admin@veloura.com](mailto:admin@veloura.com)"
SEED_ADMIN_PASSWORD="CHANGE_THIS_ADMIN_PASSWORD"
